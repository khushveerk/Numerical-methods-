Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"x0", " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x1", " ", "=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Nmax", " ", "=", " ", "20"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eps", " ", "=", " ", "0.0001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"f", "[", "x0", "]"}], "*", 
      RowBox[{"f", "[", "x1", "]"}]}], "]"}], " ", ">", " ", "0"}], " ", ",", 
   "\[IndentingNewLine]", 
   RowBox[{
   "Print", "[", 
    "\"\<Your value do not satisfy the IVP, so change the values\>\"", "]"}], 
   ",", " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", " ", "=", " ", "1"}], ",", " ", 
      RowBox[{"i", "\[LessEqual]", "Nmax"}], ",", " ", 
      RowBox[{"i", "++"}], ",", " ", 
      RowBox[{
       RowBox[{"m", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x0", "+", "x1"}], ")"}], "/", "2"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x1", "-", "x0"}], ")"}], "/", "2"}], "]"}], "<", 
          "eps"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Return", "[", 
          RowBox[{"N", "[", "m", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"i", ",", "\"\<th iteration value is :\>\"", ",", " ", 
            RowBox[{"N", "[", "m", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<estimated error in\>\"", " ", ",", " ", "i", " ", ",", " ", 
            "\"\< the iteration is :\>\"", ",", " ", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x1", "-", "x0"}], ")"}], "/", "2"}], "]"}]}], "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"f", "[", "m", "]"}], "*", 
              RowBox[{"f", "[", "x1", "]"}]}], ">", "0"}], ",", " ", 
            RowBox[{"x1", "=", "m"}], ",", " ", 
            RowBox[{"x0", "=", "m"}]}], "]"}]}]}], "]"}]}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Root is: \>\"", ",", " ", "m"}], "]"}], "*", 
     "\[IndentingNewLine]", " ", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<estimated error in\>\"", ",", " ", "\"\<the iteration is :\>\"", 
       ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x1", "-", "x0"}], ")"}], "/", "2"}]}], "]"}]}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.997241116858511*^9, 3.997241130647353*^9}, {
  3.9972411646861315`*^9, 3.9972412812153845`*^9}, {3.997241315974551*^9, 
