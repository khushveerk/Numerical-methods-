Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"GaussJacobi", "[", 
    RowBox[{"A0_", ",", "b0_", ",", "X0_", ",", "maxtier_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A", "=", 
        RowBox[{"N", "[", "A0", "]"}]}], ",", 
       RowBox[{"b", "=", 
        RowBox[{"N", "[", "b0", "]"}]}], ",", 
       RowBox[{"xk", "=", "X0"}], ",", "xk1", ",", "i", ",", "j", ",", 
       RowBox[{"k", "=", "0"}], ",", "n", ",", "m", ",", "OutputDetails", ",",
        "colHeading"}], "}"}], ",", 
     RowBox[{
      RowBox[{"size", "=", 
       RowBox[{"Dimensions", "[", "A", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", "=", 
       RowBox[{"size", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"m", "=", 
       RowBox[{"size", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"n", "\[NotEqual]", "m"}], ",", 
        RowBox[{
         RowBox[{
         "Print", "[", 
          "\"\<Not a square matrix, cannot proceed with Gauss-Jacobi method\>\
\"", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Return", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"OutputDetails", "=", 
