Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"LagrangePolynomial", "[", 
    RowBox[{"x0_", ",", "f0_"}], "]"}], " ", ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xi", "=", "x0"}], ",", 
       RowBox[{"fi", "=", "f0"}], ",", "n", ",", "m", ",", "polynomial"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "xi", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"m", "=", 
       RowBox[{"Length", "[", "fi", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"n", "\[NotEqual]", "  ", "m"}], ",", 
        RowBox[{
         RowBox[{
         "Print", "[", 
          "\"\<List of points and functions values are not of same size\>\"", 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Return", "[", "]"}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "\[LessEqual]", " ", "n"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"L", "[", 
           RowBox[{"i", ",", "x_"}], "]"}], "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Product", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", " ", 
                RowBox[{"x", "-", 
                 RowBox[{"xi", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"xi", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "-", 
                 RowBox[{"xi", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", 
                RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}], ")"}], "*", 
           "\[IndentingNewLine]", 
           RowBox[{"(", 
            RowBox[{"Product", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"x", "-", 
                 RowBox[{"xi", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"xi", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "-", 
                 RowBox[{"xi", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", 
                RowBox[{"i", "+", "1"}], ",", "n"}], "}"}]}], "]"}], 
            ")"}]}]}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"polynomial", "[", "x_", "]"}], "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"L", "[", 
           RowBox[{"k", ",", "x"}], "]"}], "*", 
          RowBox[{"fi", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"polynomial", "[", "x", "]"}], "]"}], ";"}]}], "]"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nodes", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "3"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"values", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3", ",", "55"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lagrangePolynomial", "[", "x_", "]"}], "=", 
  RowBox[{"LagrangePolynomial", "[", 
   RowBox[{"nodes", ",", "values"}], "]"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9996583411492443`*^9, 3.999658410935125*^9}, {
  3.9996584509501863`*^9, 3.9996585670960474`*^9}, {3.999658630729909*^9, 
