Notebook[{

Cell[CellGroupData[{
Cell["\<\
Practical - RK Method 
\
\>", "Title",
 CellChangeTimes->{{4.0008702770198193`*^9, 4.000870349371889*^9}, {
  4.000870381019313*^9, 4.0008703826352253`*^9}}],

Cell["Question-1", "Subtitle",
 CellChangeTimes->{{4.0008703730674767`*^9, 4.000870379003389*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"RK4thOrder", "[", 
     RowBox[{
     "a0_", ",", "b0_", ",", "n0_", ",", "f_", ",", "alpha_", ",", 
      "actualSolution_"}], "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", "=", "a0"}], ",", 
        RowBox[{"b", "=", "b0"}], ",", 
        RowBox[{"n", "=", "n0"}], ",", "h", ",", "ti", ",", "K1", ",", "K2", 
        ",", "K3", ",", "K4"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"h", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"b", "-", "a"}], ")"}], "/", "n"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ti", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"a", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"j", "-", "1"}], ")"}], "h"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", 
            RowBox[{"n", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"wi", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"n", "+", "1"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"wi", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "=", "alpha"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"actualSol", "=", 
        RowBox[{"actualSolution", "[", 
         RowBox[{"ti", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"difference", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{"actualSol", "-", 
          RowBox[{"wi", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"OutputDetails", "=", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"ti", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", "alpha", ",", "actualSol", 
           ",", "difference"}], "}"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "\[LessEqual]", "n"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"K1", "=", 
           RowBox[{"h", "*", 
            RowBox[{"f", "[", 
             RowBox[{
              RowBox[{"ti", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"wi", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"K2", "=", 
           RowBox[{"h", "*", 
            RowBox[{"f", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ti", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", 
               RowBox[{"h", "/", "2"}]}], ",", 
              RowBox[{
               RowBox[{"wi", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", 
               RowBox[{"K1", "/", "2"}]}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"K3", "=", 
           RowBox[{"h", "*", 
            RowBox[{"f", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ti", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", 
               RowBox[{"h", "/", "2"}]}], ",", 
              RowBox[{
               RowBox[{"wi", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", 
               RowBox[{"K2", "/", "2"}]}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"K4", "=", 
           RowBox[{"h", "*", 
            RowBox[{"f", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ti", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", "h"}], ",", 
              RowBox[{
               RowBox[{"wi", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", "K3"}]}], "]"}]}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"wi", "[", 
            RowBox[{"[", 
             RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
           RowBox[{
            RowBox[{"wi", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "/", "6"}], ")"}], "*", 
             RowBox[{"(", 
              RowBox[{"K1", "+", 
               RowBox[{"2", "K2"}], "+", 
               RowBox[{"2", "K3"}], "+", "K4"}], ")"}]}]}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"actualSol", "=", 
           RowBox[{"actualSolution", "[", 
            RowBox[{"ti", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"difference", "=", 
           RowBox[{"Abs", "[", 
            RowBox[{"actualSol", "-", 
             RowBox[{"wi", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"OutputDetails", "=", 
           RowBox[{"Append", "[", 
            RowBox[{"OutputDetails", ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"N", "[", 
                RowBox[{"ti", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", "+", "1"}], "]"}], "]"}], "]"}], ",", 
               RowBox[{"N", "[", 
                RowBox[{"wi", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", "+", "1"}], "]"}], "]"}], "]"}], ",", 
               RowBox[{"N", "[", "actualSol", "]"}], ",", 
               RowBox[{"N", "[", "difference", "]"}]}], "}"}]}], "]"}]}], 
          ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"TableForm", "[", 
           RowBox[{"OutputDetails", ",", 
            RowBox[{"TableHeadings", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"None", ",", 
               RowBox[{"{", 
                RowBox[{
                "\"\<i\>\"", ",", ",", "\"\<ti\>\"", ",", " ", "\"\<wi\>\"", 
                 ",", "\"\<actSol(ti)\>\"", ",", 
                 "\"\<Abs(wi-actSol(ti))\>\""}], "}"}]}], "}"}]}]}], "]"}], 
          ",", "6"}], "]"}], "]"}], ";"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"t_", ",", "x_"}], "]"}], ":=", " ", 
   RowBox[{"1", "+", 
    RowBox[{"x", "/", "t"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"actualSolution", "[", "t_", "]"}], ":=", " ", 
   RowBox[{"t", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"Log", "[", "t", "]"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RK4thOrder", "[", 
   RowBox[{
   "1", ",", "6", ",", "10", ",", "f", ",", "1", ",", "actualSolution"}], 
   "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{4.000870397530897*^9, 4.000870500512541*^9}, {
  4.000870533214706*^9, 4.000870556026804*^9}, {4.000870594559229*^9, 
  4.0008707924751596`*^9}, {4.0008708511202097`*^9, 4.000871181647112*^9}, {
  4.0008712227102175`*^9, 4.0008714794991264`*^9}, {4.0008715899510803`*^9, 
