Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GaussSeidel", "[", 
     RowBox[{"A0_", ",", "b0_", ",", "X0_", ",", "maxtier_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"A", "=", 
         RowBox[{"N", "[", "A0", "]"}]}], ",", 
        RowBox[{"b", "=", 
         RowBox[{"N", "[", "b0", "]"}]}], ",", 
        RowBox[{"xk", "=", "X0"}], ",", "xk1", ",", "i", ",", "j", ",", 
        RowBox[{"k", "=", "0"}], ",", "n", ",", "m", ",", "OutputDetails"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"size", "=", 
        RowBox[{"Dimensions", "[", "A", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"size", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"m", "=", 
        RowBox[{"size", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"n", "\[NotEqual]", "m"}], ",", 
         RowBox[{
          RowBox[{
          "Print", "[", 
           "\"\<Not a square matrix, cannot proceed with Gauss se method\>\"",
            "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"OutputDetails", "=", 
        RowBox[{"{", "xk", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xk1", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", "n", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"k", "<", "maxtier"}], ",", 
         RowBox[{
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "1"}], ",", 
            RowBox[{"i", "\[LessEqual]", "n"}], ",", 
            RowBox[{"i", "++"}], ",", 
