Cell[CellGroupData[{
Cell[TextData[{
 StyleBox["PRACTICAL 7( Lagrange Interpolation)",
  FontColor->RGBColor[1, 0, 0]],
 "\nP-1:\n"
}], "Subchapter",
 CellChangeTimes->{{3.99965833043701*^9, 3.999658369396643*^9}, {
  3.9996584504215736`*^9, 3.9996584738933535`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"CLEAR", " ", "ALL"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LagrangePolynomial", "[", 
    RowBox[{"x0_", ",", "f0_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xi", "=", "x0"}], ",", 
       RowBox[{"fi", "=", "f0"}], ",", "n", ",", "m", ",", "polynomial"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "xi", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"m", "=", 
       RowBox[{"Length", "[", "fi", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"n", "\[NotEqual]", "m"}], ",", 
        RowBox[{
         RowBox[{
         "Print", "[", 
          "\"\<List of Points and Function values are not of same size\>\"", 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Return", "[", "]"}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "\[LessEqual]", "n"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"L", "[", 
           RowBox[{"i", ",", "x_"}], "]"}], "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Product", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"x", "-", 
                 RowBox[{"xi", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"xi", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "-", 
                 RowBox[{"xi", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", 
                RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}], ")"}], "*", 
           RowBox[{"(", 
            RowBox[{"Product", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"x", "-", 
                 RowBox[{"xi", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"xi", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "-", 
                 RowBox[{"xi", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", 
                RowBox[{"i", "+", "1"}], ",", "n"}], "}"}]}], "]"}], 
            ")"}]}]}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"polynomial", "[", "x_", "]"}], "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"L", "[", 
           RowBox[{"k", ",", "x"}], "]"}], "*", 
          RowBox[{"fi", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"polynomial", "[", "x", "]"}], "]"}], ";"}]}], "]"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\n"}], "\n"}], "Input",
 CellChangeTimes->{{3.9996584618802853`*^9, 3.9996588936368237`*^9}, {
   3.9996591024868703`*^9, 3.999659103638686*^9}, {3.99965919021471*^9, 
