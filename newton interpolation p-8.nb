P-1 Computing Divided Difference
\
\>", "Subtitle",
 CellChangeTimes->{{3.999662261665497*^9, 3.999662320228852*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{"CLEARALL", "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NthDividedDiff", "[", 
    RowBox[{"x0_", ",", "f0_", ",", "startindex_", ",", "endindex_"}], "]"}], 
   " ", ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", " ", "=", " ", "x0"}], ",", 
       RowBox[{"f", " ", "=", " ", "f0"}], ",", " ", 
       RowBox[{"i", " ", "=", " ", "startindex"}], ",", 
       RowBox[{"j", " ", "=", " ", "endindex"}], ",", "answer"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"i", "\[Equal]", "j"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"f", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"answer", " ", "=", " ", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"NthDividedDiff", "[", 
              RowBox[{"x", ",", "f", ",", 
               RowBox[{"i", "+", "1"}], ",", "j"}], "]"}], "-", 
             RowBox[{"NthDividedDiff", "[", 
              RowBox[{"x", ",", "f", ",", "i", ",", 
               RowBox[{"j", "-", "1"}]}], "]"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"x", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "-", 
             RowBox[{"x", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Return", "[", "answer", "]"}]}]}], "]"}], ";"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9996623257741036`*^9, 3.9996624449166355`*^9}, {
   3.999662475600601*^9, 3.9996626268353357`*^9}, 3.9996627258452673`*^9}],

Cell[BoxData["CLEARALL"], "Output",
 CellChangeTimes->{3.9996626290118465`*^9, 3.9996628140422792`*^9}]
}, Open  ]],

